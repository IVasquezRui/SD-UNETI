# Copia este archivo a .env y ajusta los valores antes de levantar el entorno.
# .env no se versiona.

COMPOSE_PROJECT_NAME=wordpress-headless

# Base de datos
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=change-me-wordpress
DB_DATA_DIR=./db_data

# WordPress
WORDPRESS_PORT=8080
WORDPRESS_URL=http://localhost:8080
WORDPRESS_TITLE=UNETI
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-admin
WORDPRESS_ADMIN_EMAIL=admin@example.com
WP_DATA_DIR=./wp_data

# Frontend
FRONTEND_PORT=3000
SISU_URL=http://localhost:8000
SIS_URL=http://localhost:8080

# Imágenes fijadas para reproducibilidad
MARIADB_IMAGE=mariadb:11.4.13
WORDPRESS_IMAGE=wordpress:7.1.3-php8.5-apache
BUN_IMAGE=oven/bun:1.4.4-alpine

# Nombres para ejecución local o en paralelo.
# Cámbialos si vas a levantar dos entornos en la misma máquina.
MARIADB_CONTAINER_NAME=wp_mariadb
WORDPRESS_CONTAINER_NAME=wp_site
FRONTEND_CONTAINER_NAME=next_frontend
NETWORK_NAME=frontend_net
